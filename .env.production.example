# Copy this file to .env.production and replace the placeholder secrets.
# The image must be a released, immutable tag.
TODO_IMAGE=ghcr.io/smexhehe/todo_java:v1.1.0

POSTGRES_PASSWORD=change-this-postgres-password
TODO_PASSWORD=change-this-application-password
GRAFANA_ADMIN_PASSWORD=change-this-grafana-password

# Services bind to loopback by default. Publish them through a reverse proxy if needed.
TODO_HOST_PORT=7540
PROMETHEUS_HOST_PORT=9090
GRAFANA_HOST_PORT=3000
ALERTMANAGER_HOST_PORT=9093